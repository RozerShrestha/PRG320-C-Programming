<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
      internalLogLevel="Off"
	  throwExceptions="false"
      internalLogFile="${basedir}\logs\internallog.log">

	<!-- enable asp.net core layout renderers -->
	<extensions>
		<add assembly="NLog.Web.AspNetCore"/>
	</extensions>

	<!-- the targets to write to -->
	<targets>
		<!-- File Target for all log messages with basic details -->
		<target xsi:type="File" name="logfile" fileName="${baseDir}/Logs/${shortdate}.log"
				layout="${longdate}|${event-properties:item=EventId:whenEmpty=0}|${level:uppercase=true}|${logger}|${message} ${exception:format=tostring}" />
		<target xsi:type="ColoredConsole" name="consoleTarget"  layout="${longdate} ${uppercase:${level}} ${message}" />
	</targets>

	<!-- rules to map from logger name to target -->
	<rules>
		<logger name="*" minlevel="Info" writeTo="file,console" />
		<logger name="Microsoft.EntityFrameworkCore.*" minlevel="Warning" writeTo="file,console" final="true" />
		<logger name="*" minlevel="Debug" writeTo="logfile" />
	</rules>
</nlog>


<!-- ✅ Keep your app logs --><!--
<logger name="BusinessManagementSystem*" minlevel="Info" writeTo="file,console" />

--><!-- 🔇 EF Core SQL: only warnings/errors --><!--
<logger name="Microsoft.EntityFrameworkCore.Database.Command" minlevel="Warning" writeTo="file,console" final="true" />

--><!-- 🔇 EF Core update pipeline --><!--
<logger name="Microsoft.EntityFrameworkCore.Update" minlevel="Warning" writeTo="file,console" final="true" />

--><!-- 🔇 ASP.NET Core framework noise --><!--
<logger name="Microsoft.AspNetCore.Hosting.Diagnostics" minlevel="Warning" writeTo="file,console" final="true" />
<logger name="Microsoft.AspNetCore.Routing.EndpointMiddleware" minlevel="Warning" writeTo="file,console" final="true" />
<logger name="Microsoft.AspNetCore.Mvc.*" minlevel="Warning" writeTo="file,console" final="true" />
<logger name="Microsoft.AspNetCore.DataProtection.*" minlevel="Error" writeTo="file,console" final="true" />
<logger name="Microsoft.Hosting.Lifetime" minlevel="Warning" writeTo="file,console" final="true" />
<logger name="Microsoft.AspNetCore.HttpsPolicy.HttpsRedirectionMiddleware" minlevel="Error" writeTo="file,console" final="true" />

--><!-- 🔚 Last-resort rule for anything else --><!--
<logger name="*" minlevel="Warning" writeTo="file,console" />-->