@model IEnumerable<PropertyRentalSystem.Models.Property>
@using PropertyRentalSystem.Helpers
@{
    ViewData["Title"] = "Home";
}

<!-- Hero Section -->
<div class="bg-primary text-white py-5">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-6">
                <h1 class="display-4 fw-bold">Find Your Perfect Stay</h1>
                <p class="lead">Discover amazing properties for rent worldwide. Book your next adventure today!</p>
                <a asp-controller="WebProperties" asp-action="Index" class="btn btn-light btn-lg mt-3">
                    <i class="bi bi-search"></i> Browse Properties
                </a>
            </div>
            <div class="col-lg-6">
                <img src="https://images.unsplash.com/photo-1564013799919-ab600027ffc6?w=600&h=400&fit=crop" 
                     alt="Property" class="img-fluid rounded shadow" />
            </div>
        </div>
    </div>
</div>

<!-- Search Section -->
<div class="container my-5">
    <div class="card shadow">
        <div class="card-body p-4">
            <h3 class="mb-4">Search Properties</h3>
            <form method="get" asp-controller="WebProperties" asp-action="Index">
                <div class="row g-3">
                    <div class="col-md-3">
                        <label class="form-label">City</label>
                        <input type="text" name="city" class="form-control" placeholder="Enter city" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Check-in</label>
                        <input type="date" name="checkIn" class="form-control" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Check-out</label>
                        <input type="date" name="checkOut" class="form-control" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Guests</label>
                        <input type="number" name="guests" class="form-control" placeholder="Number of guests" min="1" />
                    </div>
                </div>
                <div class="row mt-3">
                    <div class="col-12">
                        <button type="submit" class="btn btn-primary btn-lg">
                            <i class="bi bi-search"></i> Search
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Features Section -->
<div class="container my-5">
    <h2 class="text-center mb-5">Why Choose Us?</h2>
    <div class="row g-4">
        <div class="col-md-4">
            <div class="card h-100 text-center border-0 shadow-sm">
                <div class="card-body">
                    <i class="bi bi-shield-check text-primary" style="font-size: 3rem;"></i>
                    <h4 class="mt-3">Secure Booking</h4>
                    <p>Your bookings are secure with our verified payment system</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100 text-center border-0 shadow-sm">
                <div class="card-body">
                    <i class="bi bi-house-heart text-primary" style="font-size: 3rem;"></i>
                    <h4 class="mt-3">Best Properties</h4>
                    <p>Carefully curated properties to match your preferences</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100 text-center border-0 shadow-sm">
                <div class="card-body">
                    <i class="bi bi-headset text-primary" style="font-size: 3rem;"></i>
                    <h4 class="mt-3">24/7 Support</h4>
                    <p>Our support team is always ready to help you</p>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Featured Properties -->
@if (Model != null && Model.Any())
{
    <div class="bg-light py-5">
        <div class="container">
            <h2 class="text-center mb-5">Featured Properties</h2>
            <div class="row g-4">
                @foreach (var property in Model)
                {
                    <div class="col-md-4">
                        <div class="card h-100 shadow-sm">
                            @if (property.Images.Any())
                            {
                                <img src="@property.Images.First().ImageUrl" class="card-img-top" alt="@property.Title" style="height: 200px; object-fit: cover;" />
                            }
                            else
                            {
                                <img src="https://via.placeholder.com/400x200?text=No+Image" class="card-img-top" alt="No Image" />
                            }
                            <div class="card-body">
                                <h5 class="card-title">@property.Title</h5>
                                <p class="text-muted">
                                    <i class="bi bi-geo-alt"></i> @property.City, @property.Country
                                </p>
                                <p class="card-text">@property.Description.Substring(0, Math.Min(100, property.Description.Length))...</p>
                                <div class="d-flex justify-content-between align-items-center">
                                    <span class="h5 text-primary mb-0">$@property.PricePerNight<small>/night</small></span>
                                    <a asp-controller="WebProperties" asp-action="Details" asp-route-id="@property.Id" class="btn btn-outline-primary btn-sm">
                                        View Details
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
            <div class="text-center mt-4">
                <a asp-controller="WebProperties" asp-action="Index" class="btn btn-primary">View All Properties</a>
            </div>
        </div>
    </div>
}

<!-- CTA Section -->
@if (!Context.Session.IsAuthenticated())
{
    <div class="container my-5 py-5">
        <div class="card bg-primary text-white shadow-lg">
            <div class="card-body text-center p-5">
                <h2 class="display-5 fw-bold">Ready to Get Started?</h2>
                <p class="lead">Join thousands of hosts and guests on our platform</p>
                <div class="mt-4">
                    <a asp-controller="WebAccount" asp-action="Register" class="btn btn-light btn-lg me-3">
                        <i class="bi bi-person-plus"></i> Register as Guest
                    </a>
                    <a asp-controller="WebAccount" asp-action="Register" class="btn btn-outline-light btn-lg">
                        <i class="bi bi-house-add"></i> Register as Host
                    </a>
                </div>
            </div>
        </div>
    </div>
}
