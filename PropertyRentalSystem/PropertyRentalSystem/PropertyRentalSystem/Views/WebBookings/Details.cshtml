@model PropertyRentalSystem.Models.Booking
@{
    ViewData["Title"] = "Booking Details";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1><i class="bi bi-receipt"></i> Booking Details</h1>
        <a asp-action="MyBookings" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Back to My Bookings
        </a>
    </div>
    
    <div class="row">
        <div class="col-lg-8">
            <!-- Booking Information Card -->
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0"><i class="bi bi-info-circle"></i> Booking Information</h5>
                </div>
                <div class="card-body">
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <strong>Booking ID:</strong><br />
                            <span class="text-muted">#@Model.Id</span>
                        </div>
                        <div class="col-md-6">
                            <strong>Status:</strong><br />
                            @switch (Model.Status.ToString())
                            {
                                case "Pending":
                                    <span class="badge bg-warning text-dark fs-6">Pending</span>
                                    break;
                                case "Confirmed":
                                    <span class="badge bg-success fs-6">Confirmed</span>
                                    break;
                                case "Completed":
                                    <span class="badge bg-info fs-6">Completed</span>
                                    break;
                                case "Cancelled":
                                    <span class="badge bg-danger fs-6">Cancelled</span>
                                    break;
                            }
                        </div>
                    </div>
                    
                    <hr />
                    
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <strong><i class="bi bi-calendar-event"></i> Check-in:</strong><br />
                            <span class="text-muted">@Model.CheckInDate.ToString("MMMM dd, yyyy")</span>
                        </div>
                        <div class="col-md-6">
                            <strong><i class="bi bi-calendar-x"></i> Check-out:</strong><br />
                            <span class="text-muted">@Model.CheckOutDate.ToString("MMMM dd, yyyy")</span>
                        </div>
                    </div>
                    
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <strong><i class="bi bi-people"></i> Number of Guests:</strong><br />
                            <span class="text-muted">@Model.NumberOfGuests</span>
                        </div>
                        <div class="col-md-6">
                            <strong><i class="bi bi-calendar3"></i> Booking Date:</strong><br />
                            <span class="text-muted">@Model.CreatedAt.ToString("MMMM dd, yyyy")</span>
                        </div>
                    </div>
                    
                    @if (!string.IsNullOrEmpty(Model.SpecialRequests))
                    {
                        <hr />
                        <strong><i class="bi bi-chat-left-text"></i> Special Requests:</strong><br />
                        <p class="text-muted mt-2">@Model.SpecialRequests</p>
                    }
                </div>
            </div>
            
            <!-- Property Information Card -->
            @if (Model.Property != null)
            {
                <div class="card shadow-sm mb-4">
                    <div class="card-header bg-info text-white">
                        <h5 class="mb-0"><i class="bi bi-building"></i> Property Information</h5>
                    </div>
                    <div class="card-body">
                        <h4>@Model.Property.Title</h4>
                        <p class="text-muted">
                            <i class="bi bi-geo-alt"></i> @Model.Property.Address, @Model.Property.City, @Model.Property.Country @Model.Property.ZipCode
                        </p>
                        
                        <div class="row mt-3">
                            <div class="col-md-4">
                                <i class="bi bi-people"></i> Max Guests: @Model.Property.MaxGuests
                            </div>
                            <div class="col-md-4">
                                <i class="bi bi-door-closed"></i> Bedrooms: @Model.Property.Bedrooms
                            </div>
                            <div class="col-md-4">
                                <i class="bi bi-droplet"></i> Bathrooms: @Model.Property.Bathrooms
                            </div>
                        </div>
                        
                        <a asp-controller="WebProperties" asp-action="Details" asp-route-id="@Model.PropertyId" class="btn btn-outline-primary mt-3">
                            <i class="bi bi-eye"></i> View Property Details
                        </a>
                    </div>
                </div>
            }
        </div>
        
        <div class="col-lg-4">
            <!-- Price Summary Card -->
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0"><i class="bi bi-currency-dollar"></i> Price Summary</h5>
                </div>
                <div class="card-body">
                    <div class="d-flex justify-content-between mb-2">
                        <span>Total Price:</span>
                        <strong class="text-success">${@Model.TotalPrice}</strong>
                    </div>
                    
                    @if (Model.Payment != null)
                    {
                        <hr />
                        <div class="alert alert-success mb-0">
                            <i class="bi bi-check-circle"></i> Payment Completed<br />
                            <small>on @(Model.Payment.PaidAt.HasValue ? Model.Payment.PaidAt.Value.ToString("MMM dd, yyyy") : "N/A")</small>
                        </div>
                    }
                    else
                    {
                        <hr />
                        <div class="alert alert-warning mb-0">
                            <i class="bi bi-exclamation-triangle"></i> Payment Pending
                        </div>
                    }
                </div>
            </div>
            
            <!-- Actions Card -->
            @if (Model.Status == PropertyRentalSystem.Models.BookingStatus.Pending || Model.Status == PropertyRentalSystem.Models.BookingStatus.Confirmed)
            {
                <div class="card shadow-sm">
                    <div class="card-header">
                        <h5 class="mb-0"><i class="bi bi-gear"></i> Actions</h5>
                    </div>
                    <div class="card-body">
                        <form asp-action="Cancel" asp-route-id="@Model.Id" method="post">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-danger w-100" 
                                    onclick="return confirm('Are you sure you want to cancel this booking?')">
                                <i class="bi bi-x-circle"></i> Cancel Booking
                            </button>
                        </form>
                    </div>
                </div>
            }
        </div>
    </div>
</div>
